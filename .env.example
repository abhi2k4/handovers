# Handovers environment: the template `python setup.py` turns into .env.
#
#   python setup.py          create .env (asks a few questions, generates every secret)
#   python setup.py --help   other modes (--update, --force, --print, --yes)
#
# Read by Docker Compose (root docker-compose.yml) and by the backend and frontend when they run
# on the host. Never commit .env. Values marked "generated" are replaced with random ones by setup;
# the ones shown here are local-development fallbacks if you copy this file by hand.

# ---- Docker Compose ----
# "auth" adds Keycloak (sign-in) to `docker compose up`. Empty = no sign-in, "View as" only.
COMPOSE_PROFILES=auth

# ---- Ports on this machine (setup moves a taken port to the next free one) ----
FRONTEND_PORT=5173
BACKEND_PORT=8000
FALKORDB_PORT=6379
FALKORDB_BROWSER_PORT=3000
KEYCLOAK_PORT=8180

# ---- FalkorDB ----
FALKORDB_HOST=localhost
# generated
FALKORDB_PASSWORD=handovers-dev
# One FalkorDB graph per tenant: handovers__<tenant>
HANDOVERS_TENANT=northwind

# ---- Backend ----
LOG_LEVEL=INFO
# Where the browser opens the app (sign-in comes back here). Derived from FRONTEND_PORT by setup.
APP_PUBLIC_URL=http://localhost:5173
# Origins allowed to call the API directly (the dev server and Docker both proxy /api anyway).
CORS_ORIGINS=http://localhost:5173
# Encrypts credentials entered in the app and seals sign-in attempts. Changing it later means
# re-entering connector tokens. generated
APP_SECRET_KEY=
# Demo clock pin (ISO-8601) so the sample company always looks the same. Empty = real clock.
DEMO_NOW=2026-10-12T10:00:00+05:30
# Load the sample company into an empty graph at startup (never overwrites data). Off for a real company.
SEED_ON_START=true
# Allow "Reload sample company" in the app (POST /api/demo/reset).
ALLOW_RESET=true
# Background jobs inside the backend: daily digest, last-day alerts, departures, letters.
JOBS_ENABLED=true
# How often the job worker checks for due jobs, in seconds.
JOBS_POLL_SECONDS=30

# ---- WhatsApp alerts (optional: empty = alerts show in the app only) ----
# Usually entered in the app instead: Integrations > Alerts (platform admin; stored encrypted, the
# app's values win, and its master switch turns WhatsApp off for everyone). These are the fallback.
# Meta WhatsApp Cloud API: developers.facebook.com > your app > WhatsApp > API Setup.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Any string; Meta sends it back when you register the webhook /api/whatsapp/webhook.
WHATSAPP_VERIFY_TOKEN=
# Approved template with one body variable, used outside WhatsApp's 24-hour reply window.
WHATSAPP_TEMPLATE=

# ---- Email alerts (optional; also set in the app: Integrations > Alerts) ----
# Docker uses the bundled Mailpit when SMTP_HOST is empty: every email lands in a local inbox at
# http://localhost:8025. Running the backend on the host: SMTP_HOST=localhost. Real mail: your
# provider's SMTP (port 587 uses STARTTLS, 465 uses TLS).
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@handovers.local

# ---- AI (optional: everything works without it, using templates) ----
# groq = Groq-hosted model with GROQ_API_KEY (free key: https://console.groq.com/keys)
# vertex = Gemini on Vertex AI (set LLM_MODEL=gemini-2.5-flash and GCP_PROJECT)
# anthropic = Claude with ANTHROPIC_API_KEY;  none = deterministic templates only
LLM_PROVIDER=none
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GCP_PROJECT=
GCP_LOCATION=global
# Local Vertex only: which gcloud account mints tokens (empty = the active account)
GCLOUD_ACCOUNT=
ANTHROPIC_API_KEY=

# ---- Sign-in (Keycloak; off while KEYCLOAK_URL is empty) ----
# How the backend reaches Keycloak when it runs on the host. In Docker it uses http://keycloak:8180.
KEYCLOAK_URL=http://localhost:8180
# How the browser reaches Keycloak (the token issuer). Empty = same as KEYCLOAK_URL.
KEYCLOAK_PUBLIC_URL=http://localhost:8180
# Shared by Keycloak (realm import on first start) and the backend. generated
KEYCLOAK_CLIENT_SECRET=handovers-dev-client-secret
# Keycloak admin console (KEYCLOAK_URL/admin) only; cannot sign in to Handovers.
KC_BOOTSTRAP_ADMIN_USERNAME=keycloak-admin
# generated
KC_BOOTSTRAP_ADMIN_PASSWORD=handovers-dev-admin
# Let visitors explore as the demo personas without signing in.
ALLOW_GUEST=true
# Local demo only: every employee can sign in with this password. Leave empty anywhere real.
# generated
DEMO_USER_PASSWORD=
# The platform admin (the Handovers team): sets up integrations and sign-in for the organisation.
# Not an employee and cannot read handover content. Signs in with email + this password. generated
PLATFORM_ADMIN_EMAIL=admin@handovers.local
PLATFORM_ADMIN_PASSWORD=
# true behind HTTPS
SESSION_COOKIE_SECURE=false

# ---- Data connectors (optional) ----
# Usually entered in the app instead: Integrations -> Connect (stored encrypted; the app's values
# win). Values here are a fallback for servers. Step-by-step setup: docs/connectors.md.
GITHUB_TOKEN=
# owner/repo, comma-separated
GITHUB_REPOS=
SLACK_BOT_TOKEN=
# channel ids, comma-separated
SLACK_CHANNELS=
# https://<site>.atlassian.net
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# project keys, comma-separated
JIRA_PROJECTS=
HUBSPOT_TOKEN=
NOTION_TOKEN=
SALESFORCE_INSTANCE_URL=
SALESFORCE_TOKEN=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Google Workspace: domain, admin to act as, service account key (JSON, one line), OAuth client
GOOGLE_DOMAIN=
GOOGLE_ADMIN_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
