// Indexes for the tenant graph. Run once per graph by `python -m seed.bootstrap`.
// One statement per line; "already indexed" errors are ignored, so this is idempotent.
CREATE INDEX FOR (n:Employee) ON (n.id)
CREATE INDEX FOR (n:Employee) ON (n.status)
CREATE INDEX FOR (n:Team) ON (n.id)
CREATE INDEX FOR (n:Role) ON (n.id)
CREATE INDEX FOR (n:Area) ON (n.id)
CREATE INDEX FOR (n:Skill) ON (n.id)
CREATE INDEX FOR (n:Responsibility) ON (n.id)
CREATE INDEX FOR (n:Account) ON (n.id)
CREATE INDEX FOR (n:Stakeholder) ON (n.id)
CREATE INDEX FOR (n:Source) ON (n.id)
CREATE INDEX FOR (n:Source) ON (n.occurred_at)
CREATE INDEX FOR (n:Knowledge) ON (n.id)
CREATE INDEX FOR (n:Knowledge) ON (n.subject)
CREATE INDEX FOR (n:Handover) ON (n.id)
CREATE INDEX FOR (n:Gap) ON (n.id)
CREATE INDEX FOR (n:Artifact) ON (n.id)
CREATE INDEX FOR (n:Transfer) ON (n.id)
CREATE INDEX FOR (n:Approval) ON (n.id)
CREATE INDEX FOR (n:ReviewItem) ON (n.id)
CREATE INDEX FOR (n:Session) ON (n.id)
CREATE FULLTEXT INDEX FOR (n:Knowledge) ON (n.text)
CREATE FULLTEXT INDEX FOR (n:Responsibility) ON (n.title)
CREATE FULLTEXT INDEX FOR (n:Source) ON (n.title, n.text)
CREATE FULLTEXT INDEX FOR (n:Stakeholder) ON (n.name, n.org, n.context)
CREATE INDEX FOR (n:Alert) ON (n.id)
CREATE INDEX FOR (n:Alert) ON (n.to)
CREATE INDEX FOR (n:AlertSettings) ON (n.employee)
CREATE INDEX FOR (n:ClearanceItem) ON (n.id)
CREATE INDEX FOR (n:Candidate) ON (n.id)
CREATE INDEX FOR (n:Policy) ON (n.id)
CREATE INDEX FOR (n:Job) ON (n.key)
CREATE INDEX FOR (n:Job) ON (n.id)
CREATE INDEX FOR (n:Job) ON (n.status)
CREATE INDEX FOR (n:Reassignment) ON (n.id)
CREATE INDEX FOR (n:Note) ON (n.id)
